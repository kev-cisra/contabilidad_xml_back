// Prisma schema - Multi-tenant (Despacho/Contador) + Multi-emisor (RFC) + Facturapi integration
// NOTE: "empresas" = tenant (despacho/contador). Cada empresa administra mÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Âºltiples emisores (RFC) y sus receptores.
// Sucursales pertenecen al EMISOR (no al tenant directamente).

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum TokenType {
  api
  refresh
  reset_password
  verify_email
  magic_login
  session
  oauth_access
}

enum TipoPersona {
  fisica
  moral
  ambas
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  expired
  trial
}

enum FacturapiEnv {
  test
  live
}

enum FacturapiOrgStatus {
  pending
  active
  blocked
  disabled
}

enum FacturapiProductTaxType {
  IVA
  ISR
  IEPS
}

enum AuditSeverity {
  info
  warn
  critical
}

enum ModuleCode {
  facturacion
  import_xml
  administracion
}

model empresas {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @default(uuid()) @unique

  // Tenant (Despacho/Contador)
  nombre     String  @db.VarChar(150)
  direccion  String  @db.VarChar(255)
  email      String  @db.VarChar(80)
  telefono   String? @db.VarChar(15)

  // SuscripciÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â³n / lÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â­mites
  subscriptionStatus      SubscriptionStatus @default(trial)
  subscriptionLastPaidAt  DateTime?
  subscriptionExpiresAt   DateTime?
  userLimit               Int @default(2) // base: 2 usuarios. Puede incrementarse por pagos.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relaciones
  usuarios  usuario[]
  menus     menus[]
  emisores  emisor[]
  roles     role[]
  permisos  permission[]

  // Entitlements / mÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â³dulos
  tenantModules tenantModule[]

  // AuditorÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â­a
  auditLogs auditLog[]

  // Pagos
  payments  subscriptionPayment[]

  @@index([subscriptionExpiresAt])
}

model usuario {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @default(uuid()) @unique

  email     String   @unique(map: "Usuario_email_key") @db.VarChar(80)
  password  String   @db.VarChar(255)
  nombre    String?  @db.VarChar(150)

  // Tenant
  empresaId BigInt
  empresa   empresas @relation(fields: [empresaId], references: [id])

  // Estado del usuario
  isOwner   Boolean  @default(false) // primer usuario / dueÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â±o (puede administrar accesos)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tokens         token[]
  usuarioRoles   usuarioRole[]
  usuarioModulos usuarioModulo[]
  auditLogs      auditLog[]

  @@index([empresaId])
}

model token {
  id         BigInt    @id @default(autoincrement())
  uuid       String    @default(uuid()) @unique

  secretHash String    @db.VarChar(255)
  type       TokenType @default(session)
  revokedAt  DateTime?
  expiresAt  DateTime
  deviceId   String?   @db.VarChar(255)

  usuarioId  BigInt
  usuario    usuario @relation(fields: [usuarioId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  @@index([usuarioId], map: "Token_usuarioId_fkey")
}

model menus {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @default(uuid()) @unique

  nombre    String   @unique @db.VarChar(100)
  orden     Int
  icono     String?  @db.VarChar(100)
  ruta      String?  @db.VarChar(150)

  parentId  BigInt?
  empresaId BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  parent    menus?   @relation("MenuToSubmenu", fields: [parentId], references: [id])
  submenus  menus[]  @relation("MenuToSubmenu")

  empresa   empresas @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
}

model regimenFiscal {
  id           BigInt     @id @default(autoincrement())
  uuid         String     @default(uuid()) @unique

  clave        String     @db.VarChar(10) @unique
  descripcion  String     @db.VarChar(255)
  tipoPersona  TipoPersona
  fechaInicio  DateTime?
  FechaFin     DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  emisores emisor[]
  satUsoCfdiRegimenes satUsoCfdiRegimenFiscal[]
}

//
// =======================
//  SAT - CatÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¡logos base
// =======================
// Nota: CatÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¡logos ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã¢â‚¬Å“globalesÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â (no por tenant). Son listas oficiales SAT usadas para validaciÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â³n UI/CFDI.
//

model satFormaPago {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satMetodoPago {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satUsoCfdi {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  regimenes satUsoCfdiRegimenFiscal[]
}

model satUsoCfdiRegimenFiscal {
  usoCfdiId       BigInt
  regimenFiscalId BigInt

  usoCfdi       satUsoCfdi    @relation(fields: [usoCfdiId], references: [id])
  regimenFiscal regimenFiscal @relation(fields: [regimenFiscalId], references: [id])

  @@id([usoCfdiId, regimenFiscalId])
  @@index([regimenFiscalId])
}

model satRelacionCfdi {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satMesBimestre {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satTipoContrato {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satTipoJornada {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satTipoRegimenNomina {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satRiesgoPuesto {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satPeriodicidadPago {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satTipoPercepcion {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satTipoHoras {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satTipoDeduccion {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @default(uuid()) @unique

  clave       String   @db.VarChar(10) @unique
  descripcion String   @db.VarChar(255)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model satTipoOtroPago {
